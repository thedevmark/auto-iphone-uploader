# Copy to .env (same folder). scripts\install_windows.ps1 fills in the first two
# lines; the rest are optional. .env is ignored by Git. Never commit it.

# Written by the installer: the pinned go-ios binary and the unsigned WebDriverAgent ipa.
GO_IOS_PATH=
WDA_IPA=

# Lets the app unlock the iPhone before a post. Typed only on the lock screen,
# refused everywhere else, never shown or logged. Leave empty if you keep the
# phone unlocked yourself.
PHONE_PASSCODE=

# Pin one iPhone when more than one is ever plugged in (ios list shows the id).
# PHONE_UDID=

# Set after Sideloadly if the app cannot find the runner by itself.
# WDA_BUNDLE_ID=com.facebook.WebDriverAgentRunner.xctrunner

# Ports the phone link uses on this PC.
# WDA_PORT=8100
# MJPEG_PORT=9100

# Where drafts, settings and the phone link's state live (default: .state in the app folder).
# VIDEO_DROP_STATE=
