{"app": "instagram", "screen": "more_options", "locale": "en", "bundle": "com.burbn.instagram",
 "signature": {"require": [{"label": "@label:more_options", "type": "StaticText"},
                           {"label": "@label:schedule_this_reel", "type": "Switch", "contains": true}]},
 "elements": {"back": {"id": "BackButton"},
              "schedule_row": {"label": "@label:schedule_this_reel", "type": "Switch", "contains": true},
              "schedule_switch": {"id": "igds-switch", "side": "inside",
                                  "relative_to": {"label": "@label:schedule_this_reel", "type": "Switch", "contains": true}},
              "schedule_is_on": {"label": "@label:schedule_this_reel_on", "type": "Switch", "contains": true},
              "highest_quality_row": {"label": "@label:highest_quality", "type": "Switch", "contains": true},
              "highest_quality_switch": {"id": "igds-switch", "side": "inside",
                                         "relative_to": {"label": "@label:highest_quality", "type": "Switch", "contains": true}},
              "highest_quality_is_on": {"label": "@label:highest_quality_on", "type": "Switch", "contains": true}},
 "actions": {"turn_on_schedule": {"tap": "schedule_switch", "expect": "schedule_sheet"},
             "toggle_highest_quality": {"tap": "highest_quality_switch", "expect": "more_options"},
             "back": {"tap": "back", "expect": "new_reel"}}}
