{"app": "instagram", "screen": "new_reel", "locale": "en", "bundle": "com.burbn.instagram",
 "signature": {"require": [{"label": "@label:new_reel", "type": "StaticText"}, {"id": "share-sheet-share-button"}]},
 "elements": {"back": {"id": "BackButton"},
              "edit_cover": {"label": "@label:edit_cover", "type": "Button"},
              "caption": {"id": "caption-cell-text-view"},
              "also_share_on": {"label": "@label:also_share_on", "type": "Cell", "contains": true},
              "more_options": {"label": "@label:more_options", "type": "Cell"},
              "save_draft": {"id": "save-draft-button"},
              "share": {"id": "share-sheet-share-button", "label": "@label:share"},
              "schedule": {"id": "share-sheet-share-button", "label": "@label:schedule"}},
 "actions": {"open_more_options": {"tap": "more_options", "expect": "more_options"},
             "open_also_share_on": {"tap": "also_share_on", "expect": "also_share_on"},
             "share": {"tap": "share", "expect": "uploading", "irreversible": true},
             "schedule": {"tap": "schedule", "expect": "uploading", "irreversible": true}}}
