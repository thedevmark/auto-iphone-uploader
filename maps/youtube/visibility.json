{"app": "youtube", "screen": "visibility", "locale": "en", "bundle": "com.google.ios.youtube",
 "signature": {"require": [{"label": "@label:set_visibility"},
                           {"label": "@label:public", "type": "Button", "contains": true}]},
 "elements": {"publish_now": {"label": "@label:publish_now", "type": "Button"},
              "public": {"label": "@label:public", "type": "Button", "contains": true},
              "unlisted": {"label": "@label:unlisted", "type": "Button", "contains": true},
              "private": {"label": "@label:private", "type": "Button", "contains": true},
              "schedule": {"label": "@label:schedule", "type": "Button"},
              "back": {"label": "@label:back", "type": "Button"}},
 "actions": {"choose_public": {"tap": "public", "expect": "visibility"},
             "choose_unlisted": {"tap": "unlisted", "expect": "visibility"},
             "choose_private": {"tap": "private", "expect": "visibility"},
             "choose_schedule": {"tap": "schedule", "expect": "schedule"},
             "back": {"tap": "back", "expect": "details"}}}
